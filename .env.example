# ==============================================================================
# Drone Manager — Exemplo de Configuração de Variáveis de Ambiente (.env.example)
# Copie este arquivo para .env (cp .env.example .env && chmod 600 .env)
# NUNCA faça commit do arquivo .env real com suas chaves privadas!
# ==============================================================================

# [Obrigatório para logs v13+] Chave gratuita da DJI Developer (Open API)
DJI_API_KEY="sua_chave_dji_developer_aqui"

# [Obrigatório para Replay 3D] Token gratuito do Cesium Ion (CesiumWorldTerrain)
CESIUM_TOKEN="seu_token_cesium_ion_aqui"

# Fuso horário local em horas em relação ao UTC (padrão: -3 para Brasília/Rio)
TZ_OFFSET=-3

# Pasta onde ficam os arquivos DJIFlightRecord_*.txt copiados do celular
LOGS_DIR="data/logs"

# Pasta principal padrão de fotos, vídeos e .SRT (suporta caminhos WSL /mnt/... ou locais)
MEDIA_DIR="/mnt/e/DJI"

# [Opcional] Pasta de destino de backup para verificar quais mídias já possuem cópia
BACKUP_DIR=""

# [Opcional] URL extra de tiles XYZ de espaço aéreo
AIRSPACE_TILES=""

# Limite de horas de voo para alerta de manutenção/troca de hélices (padrão: 50)
PROP_LIMIT_H=50

# Caminho ou nome do binário do parser de logs da DJI (instalado via cargo)
DJI_LOG_BIN="dji-log"
