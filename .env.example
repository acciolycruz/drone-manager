# ==============================================================================
# Drone Manager — Environment Variables Template (.env.example)
# Copy this file to .env (cp .env.example .env && chmod 600 .env)
# NEVER commit your real .env file with private keys!
# ==============================================================================

# [Required for v13+ logs] Free DJI Developer key (Open API)
DJI_API_KEY="your_dji_developer_key_here"

# [Required for 3D Replay] Free Cesium Ion token (CesiumWorldTerrain)
CESIUM_TOKEN="your_cesium_ion_token_here"

# Local timezone offset in hours from UTC (default: -3 for Brasília/Rio)
TZ_OFFSET=-3

# Directory containing DJIFlightRecord_*.txt (or .csv / .ulg / .bin) logs
LOGS_DIR="data/logs"

# Default root directory for photos, videos, and .SRT (supports WSL /mnt/... or local paths)
MEDIA_DIR="/mnt/e/DJI"

# [Optional] Backup destination path used by backup.sh and backup status checks
BACKUP_DIR=""

# [Optional] Extra XYZ airspace tile URL
AIRSPACE_TILES=""

# Flight hours threshold for propeller replacement alert (default: 50)
PROP_LIMIT_H=50

# Name or full path to the dji-log binary (installed via cargo)
DJI_LOG_BIN="dji-log"

# [Optional] Bind host and port used by start.sh
HOST="127.0.0.1"
PORT="8000"

# [Optional] Comma-separated extra hostnames allowed for remote NodeODM
ODM_ALLOWED_HOSTS=""

# [Optional] Set to "test" to allow FastAPI TestClient ("testserver")
# APP_ENV="test"
